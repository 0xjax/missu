<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />

    <!--
      NOTE: `android:icon` 只能有一个静态值，它决定「设置 → 应用信息」「权限弹窗」「分享面板」里的图标。
      桌面图标不读它——桌面枚举的是带 MAIN/LAUNCHER 的组件，也就是下面那五个 activity-alias。
      所以换色后会出现「桌面变了、应用信息没变」，这是机制的边界，不是 bug。
    -->
    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher_brand"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Missu">
        <!--
          NOTE: 人机验证没有独立 Activity：它是 MainActivity 组合里的一层 Dialog（ChallengeOverlayHost）。
          好处是主题、语言、色板、返回键全部继承，也不在最近任务里留一个独立页面。
        -->
        <!--
          NOTE: 启动入口不在这里，而在下面五个 activity-alias 上——图标要能换色，就只能让「桌面入口」
          是多个可启停的 alias，每个 alias 带自己的 android:icon。MainActivity 不能再挂 LAUNCHER 过滤，
          否则桌面上会出现两个入口。
        -->
        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|keyboardHidden|uiMode"
            android:exported="true"
            android:windowSoftInputMode="adjustResize" />

        <!-- 五套图标：默认只启用品牌粉，其余由 LauncherIcons 在运行时切换（先启用新的，再禁用旧的）。 -->
        <activity-alias
            android:name=".LauncherBrand"
            android:enabled="true"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_brand"
            android:label="@string/app_name"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".LauncherViolet"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_violet"
            android:label="@string/app_name"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".LauncherBlue"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_blue"
            android:label="@string/app_name"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".LauncherTeal"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_teal"
            android:label="@string/app_name"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".LauncherAmber"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_amber"
            android:label="@string/app_name"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
    </application>

</manifest>
