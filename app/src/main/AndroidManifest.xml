<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />

    <!--
      NOTE: `android:icon` 只能有一个静态值，它决定「设置 → 应用信息」「权限弹窗」「分享面板」里的图标。
      桌面图标不读它——桌面枚举的是带 MAIN/LAUNCHER 的组件，也就是下面那五个 activity-alias。
      所以换色后会出现「桌面变了、应用信息没变」，这是机制的边界，不是 bug。
    -->
    <!--
      NOTE: 预测式返回（侧滑还没松手、界面就先跟手）全靠这一个开关。别指望「targetSdk 36 +
      Android 16 会自动打开」：本机（V2507A / API 36）实测不加这一行时侧滑整屏一动不动，
      加上之后系统才会在手势期间持续回调 progress（预测式返回的落点见 DESIGN.md「Motion」）。
    -->
    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:enableOnBackInvokedCallback="true"
        tools:targetApi="33"
        android:icon="@mipmap/ic_launcher_brand"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Missu">
        <!--
          NOTE: 人机验证没有独立 Activity：它是 MainActivity 组合里的一层 Dialog（ChallengeOverlayHost）。
          好处是主题、语言、色板、返回键全部继承，也不在最近任务里留一个独立页面。
        -->
        <!--
          NOTE: 启动入口不在这里，而在下面五个 activity-alias 上——图标要能换色，就只能让「桌面入口」
          是多个可启停的 alias，每个 alias 带自己的 android:icon。MainActivity 不能再挂 LAUNCHER 过滤，
          否则桌面上会出现两个入口。
        -->
        <!--
          NOTE: `configChanges` 必须含 orientation|screenSize：播放器全屏会转到横屏，不写这两项
          就要重建 Activity，正在播的 ExoPlayer 与进度一起没。
          NOTE: 这里**不锁**横竖屏：全屏进出只改运行期 `requestedOrientation`（进横屏 / 退
          `UNSPECIFIED`），退出后回不回竖屏由用户自己的旋转锁定决定（见 `FullscreenEffect`）
          ——App 不替系统定这件事。
        -->
        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|keyboardHidden|uiMode"
            android:exported="true"
            android:windowSoftInputMode="adjustResize" />

        <!-- 五套图标：默认只启用品牌粉，其余由 LauncherIcons 在运行时切换（先启用新的，再禁用旧的）。 -->
        <activity-alias
            android:name=".LauncherBrand"
            android:enabled="true"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_brand"
            android:label="@string/app_name"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".LauncherViolet"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_violet"
            android:label="@string/app_name"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".LauncherBlue"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_blue"
            android:label="@string/app_name"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".LauncherTeal"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_teal"
            android:label="@string/app_name"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".LauncherAmber"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_amber"
            android:label="@string/app_name"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
    </application>

</manifest>
